
# Database Configuration
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mti_onboarding
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_INSTANCE=
DB_ENCRYPT=false

# Server Configuration
PORT=3001
# Set to * to allow all origins, or comma-separated list of allowed origins
ALLOWED_ORIGINS=*

# Frontend Configuration
# Use absolute URL for production or different domains
# VITE_API_URL=http://api.yourdomain.com/api
# Use relative URL if frontend and backend are on same domain
VITE_API_URL=/api

# JWT Secret (for authentication)
JWT_SECRET=your_secret_key_here

# Schema initialization settings
DB_INIT_SCHEMA=true
DB_DROP_TABLES=false

# LDAP Configuration
# Maximum number of users to retrieve from Active Directory
# Default: 1000, Set to 0 for unlimited (use with caution on large directories)
LDAP_SIZE_LIMIT=1000

# Logging Configuration
# Log levels: debug, info, warn, error, none
LOG_LEVEL=info
# Component specific logging (true/false)
LOG_API=true
LOG_DB=true
LOG_UI=true

# Security Settings
# Number of salt rounds for password hashing (higher = more secure but slower)
BCRYPT_SALT_ROUNDS=10

# Exchange Online Configuration (MFA-compatible)
# For certificate-based authentication (recommended for production)
EXO_APP_ID=your_app_id_here
EXO_TENANT_ID=your_tenant_id_here
EXO_CERTIFICATE_THUMBPRINT=your_certificate_thumbprint_here
EXO_CERTIFICATE_PATH=/path/to/certificate.pfx
EXO_CERTIFICATE_PASSWORD=your_certificate_password_here

# Legacy credential authentication (deprecated - MFA not supported)
EXO_USER=admin@mmt.com.my
