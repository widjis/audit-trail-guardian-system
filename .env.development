
# Development environment configuration

# API URL for development (relative URL works if using Vite's proxy)
VITE_API_URL=/api

# For direct connection without proxy, uncomment and use:
# VITE_API_URL=http://localhost:3001/api

# LDAP Configuration for Development
# Increase limit to retrieve more AD users (set to 0 for unlimited)
LDAP_SIZE_LIMIT=2000
